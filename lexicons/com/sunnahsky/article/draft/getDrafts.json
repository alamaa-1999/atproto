{
  "lexicon": 1,
  "id": "com.sunnahsky.article.draft.getDrafts",
  "defs": {
    "main": {
      "type": "query",
      "description": "Gets views of the authenticated account's own article drafts. Requires authentication. THIS IS A TEMPORARY UNSPECCED ROUTE, specific to this fork's article-authoring feature.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["drafts"],
          "properties": {
            "cursor": { "type": "string" },
            "drafts": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.sunnahsky.article.draft.defs#draftView"
              }
            }
          }
        }
      }
    }
  }
}
