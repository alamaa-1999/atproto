{
  "lexicon": 1,
  "id": "com.atproto.temp.listPromotionRecords",
  "defs": {
    "main": {
      "type": "query",
      "description": "Lists the PDS's record of promotion attempts, newest first: promotions, identity re-checks and refusals. Accepts the admin password, or a full password session of an active account on the PDS's admin list. THIS IS A TEMPORARY UNSPECCED ROUTE, specific to this fork's admin list.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["records"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#promotionRecord"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotAdmin",
          "description": "The calling account is not on the PDS's admin list."
        }
      ]
    },
    "promotionRecord": {
      "type": "object",
      "required": ["id", "createdAt", "actor", "subject", "outcome"],
      "properties": {
        "id": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "actor": {
          "type": "string",
          "description": "The admin account's DID, or \"admin-password\"."
        },
        "subject": {
          "type": "string",
          "description": "The account as requested: a handle or a DID."
        },
        "subjectDid": {
          "type": "string",
          "format": "did"
        },
        "handleBefore": {
          "type": "string"
        },
        "handleAfter": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "knownValues": ["promoted", "rechecked", "refused"]
        },
        "reason": {
          "type": "string",
          "description": "Why the attempt was refused."
        }
      }
    }
  }
}
