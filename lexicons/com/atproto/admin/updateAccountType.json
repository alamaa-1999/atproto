{
  "lexicon": 1,
  "id": "com.atproto.admin.updateAccountType",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Administrative action to update an account's type (person or institution).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["account", "accountType"],
          "properties": {
            "account": {
              "type": "string",
              "format": "at-identifier",
              "description": "The handle or DID of the repo."
            },
            "accountType": {
              "type": "string",
              "knownValues": ["person", "institution"]
            }
          }
        }
      }
    }
  }
}
